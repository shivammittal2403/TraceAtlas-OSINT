ctions": ["no exploits, credential attacks or offensive operations"]}}</data></node><node id="module:INFRAINT"><data key="d0">INFRAINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Internet-facing infrastructure identity, hosting, CDN, CT and historic topology", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:TECHINT"><data key="d0">TECHINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Technical products/models/revisions/capabilities and BOMs without exploitation", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:HUMINT"><data key="d0">HUMINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Consensual human-source testimony, source access and independent corroboration", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED", "skill_prompt_summary": {"focus": ["consensual interviews", "basis of knowledge", "firsthand vs hearsay", "source reliability separate from claim credibility", "memory/time limits", "independent corroboration"], "distinctions": ["source confidence ≠ accuracy", "consistent testimony ≠ verified fact", "demeanor ≠ lie detector", "refusal ≠ guilt"], "restrictions": ["no covert recruitment, coercion, blackmail, deception or identity impersonation", "no private interception or sensitive profiling"]}}</data></node><node id="module:SIGINT"><data key="d0">SIGINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Authorized passive spectrum/signals metadata, not interception or targeting", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED", "skill_prompt_summary": {"focus": ["authorized spectrum/IQ/metadata", "temporal emission pattern", "sensor calibration", "RF context"], "distinctions": ["RSSI ≠ exact distance", "device ≠ person", "unknown signal ≠ hostile"], "restrictions": ["no private interception, jamming, spoofing, tracking or targeting"]}}</data></node><node id="module:COMINT"><data key="d0">COMINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Authorized/public communications records, threads and networks", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED", "skill_prompt_summary": {"focus": ["consented/public communications", "participants/threads/forward chains", "claims vs observations", "attachments and metadata"], "distinctions": ["account ≠ person", "message claim ≠ truth", "chat frequency ≠ leadership"], "restrictions": ["no private intercept, stolen sessions, deceptive private-group joins"]}}</data></node><node id="module:ELINT"><data key="d0">ELINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Authorized non-communication emitter/spectrum measurements, no jamming/targeting", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED", "skill_prompt_summary": {"focus": ["non-communications RF/emitter descriptors", "pulse/spectrum observations", "emitter class vs platform"], "distinctions": ["emitter class ≠ exact platform", "non-detection ≠ absence"], "restrictions": ["no jamming, electronic-attack waveforms, evasion/targeting guidance"]}}</data></node><node id="module:MASINT"><data key="d0">MASINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Measurement/signature intelligence from lawful authorized public sensor data", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:BREACHINT"><data key="d0">BREACHINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Breach/exposure claims, datasets, origin, duplication, verified counts and privacy", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED", "skill_prompt_summary": {"focus": ["breach claim vs fact", "sample/dataset authenticity", "lineage/recycled leaks", "record counts", "first vs third-party origin", "data class/impact"], "distinctions": ["email in leak ≠ company breached", "sample ≠ full dataset", "new listing ≠ new breach"], "restrictions": ["no illicit purchase, full stolen-data acquisition, or reuse of exposed secrets"]}}</data></node><node id="module:CREDINT"><data key="d0">CREDINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Defensive credential/token/key exposure; never log in or replay secrets", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED", "skill_prompt_summary": {"focus": ["exposed passwords/hashes", "session tokens/keys/MFA secrets", "stealer/combo source", "account relevance", "rotation/revocation", "privacy-preserving fingerprinting"], "distinctions": ["exposed ≠ valid ≠ compromised", "password reset ≠ sessions revoked", "stealer log ≠ website breach"], "restrictions": ["never test or use passwords, keys, cookies, refresh tokens, recovery codes, or log in"]}}</data></node><node id="module:EXPLOITINT"><data key="d0">EXPLOITINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Defensive exploitation trends and asset exposure, no exploits or attack guidance", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:TTPINT"><data key="d0">TTPINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Adversary TTP observations and ATT&amp;CK mapping, not procedural offensive execution", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:DECEPTIONINT"><data key="d0">DECEPTIONINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Evidence-based deception/manipulation indicators without lie detection or manipulation tactics", "canonical_65": false, "module_status": "requested", "implementation_status": "NOT_VERIFIED", "skill_prompt_summary": {"focus": ["source-claim consistency", "provenance/cross-source contradictions", "document/media manipulation signals", "context and narrative framing", "alternative explanations"], "distinctions": ["inconsistency ≠ deliberate lie", "tone ≠ deceit", "manipulation indicator ≠ actor attribution"], "restrictions": ["no lie detection based on face/voice/emotion", "no psychological manipulation tactics or political targeting"]}}</data></node><node id="module:ORGINT"><data key="d0">ORGINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Governance, teams, reporting lines, roles vs persons, formal vs functional authority", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED", "skill_prompt_summary": {"focus": ["formal vs functional reporting", "unit/role/person separations", "delegated authority", "governance", "program/project", "capacity and dependencies", "historical changes"], "distinctions": ["title ≠ authority", "role ≠ person", "org chart ≠ actual structure"], "restrictions": ["no social engineering or private-employee targeting"]}}</data></node><node id="module:AIINT"><data key="d0">AIINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Research/AI ecosystem intelligence; do not invent model capabilities", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:PERSONINT"><data key="d0">PERSONINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "Lawful high-level entity identity with strict anti-doxxing controls", "canonical_65": false, "module_status": "extended", "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:CODEINT"><data key="d0">CODEINT</data><data key="d1">int