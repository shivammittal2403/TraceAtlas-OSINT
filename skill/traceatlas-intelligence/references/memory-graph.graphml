OINT"><data key="d0">REPOINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "GitHub/repository intelligence, commits and software ecosystem relationships", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:SUPPLYCHAININT"><data key="d0">SUPPLYCHAININT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "vendor, 4th/nth-party, software/physical dependencies, criticality and resilience", "canonical_65": true, "implementation_status": "NOT_VERIFIED", "skill_prompt_summary": {"focus": ["direct/4th/nth-party dependency", "SBOM/VEX/PURL", "cloud/IdP/CI/CD common failures", "criticality/substitution", "vendor incidents", "supplier alternatives"], "distinctions": ["contract ≠ active use", "SBOM ≠ deployed reality", "supplier incident ≠ customer compromise", "single provider ≠ SPOF"], "restrictions": ["no vendor intrusion, sabotage, malicious packages, or dependency attack prioritization"]}}</data></node><node id="module:INCIDENTINT"><data key="d0">INCIDENTINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "authorized incident case/telemetry evidence, timelines and response intelligence", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:LOGINT"><data key="d0">LOGINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "normalized authorized logs, events and detection correlation", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="group:discovery_web_research"><data key="d0">Discovery Web Research</data><data key="d1">module_group</data><data key="d2">{"canonical": true}</data></node><node id="module:WEBINT"><data key="d0">WEBINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "bounded public web collection, parsing, archiving and web evidence", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data><