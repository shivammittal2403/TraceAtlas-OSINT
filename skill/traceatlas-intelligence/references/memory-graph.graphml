 ≠ registrant", "domain age ≠ benignity", "historic owner ≠ current owner"], "restrictions": ["no domain takeover, unauthorized enumeration, registrar modification"]}}</data></node><node id="module:DNSINT"><data key="d0">DNSINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "current/passive/historical DNS and temporal provider relationships", "canonical_65": true, "implementation_status": "NOT_VERIFIED", "skill_prompt_summary": {"focus": ["A/AAAA/CNAME/MX/NS/TXT/SOA/SRV/CAA/PTR", "pDNS", "authoritative DNS", "history", "CDN/wildcard", "DNSSEC and time"], "distinctions": ["pDNS first_seen ≠ creation", "shared NS ≠ common owner", "CDN edge ≠ origin"], "restrictions": ["no poisoning, unauthorized AXFR, DNS abuse"]}}</data></node><node id="module:CERTINT"><data key="d0">CERTINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "X.509, CT, chains, cert history and cautious reuse analysis", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:IPINT"><data key="d0">IPINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "IP/prefix/RIR/RDAP/ASN context, usage eras and reputation", "canonical_65": true, "implementation_status": "NOT_VERIFIED", "skill_prompt_summary": {"focus": ["RIR/RDAP/ASN/BGP", "IP usage eras", "cloud/CDN sharing", "reputation freshness", "passive service evidence"], "distinctions": ["IP allocation ≠ tenant", "IP geolocation ≠ exact person", "old malicious reputation ≠ current maliciousness"], "restrictions": ["no unauthorized scans, brute-force, traffic interception"]}}</data></node><node id="module:ASNINT"><data key="d0">ASNINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "autonomous system identity and public network relationships", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:BGPINT"><data key="d0">BGPINT</data><data key="d1">intelligence_module</