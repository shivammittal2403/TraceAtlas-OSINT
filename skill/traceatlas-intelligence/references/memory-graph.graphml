rs", "OpenTelemetry", "Docker; Kubernetes only when justified"], "deployment_preferences": ["Vercel frontend (past user intent)", "Supabase backend (past user intent)", "private investigator workspace", "Oracle worker removed from prior requested architecture"], "implementation_preference": "Extend existing working code first; minimum files necessary, maximum testable functionality, no stubs, no decorative architecture, no duplicate engines, no fabricated connectors.", "current_status": "NOT VERIFIED FROM REPOSITORY FOR THIS EXPORT"}</data></node><node id="goal:ai_employee"><data key="d0">Full Intelligence Investigation AI Employee</data><data key="d1">goal</data><data key="d2">{}</data></node><node id="goal:enterprise"><data key="d0">Enterprise OSINT Workbench</data><data key="d1">goal</data><data key="d2">{}</data></node><node id="goal:evidence"><data key="d0">Evidence-first Defensible Investigation</data><data key="d1">goal</data><data key="d2">{}</data></node><node id="goal:jarvis"><data key="d0">JARVIS-style Investigator</data><data key="d1">goal</data><data key="d2">{}</data></node><node id="goal:multiagent"><data key="d0">Hierarchical Multi-Agent Workforce</data><data key="d1">goal</data><data key="d2">{}</data></node><node id="goal:memory"><data key="d0">Persistent Graphical Memory</data><data key="d1">goal</data><data key="d2">{}</data></node><node id="workflow:canonical"><data key="d0">Canonical Investigation Flow</data><data key="d1">workflow</data><data key="d2">{"flow": ["TARGET + OBJECTIVE + AUTHORIZED SCOPE", "Questions", "Knowledge State", "Gaps", "Disciplines", "Capabilities", "Sources", "Workers", "Transforms", "Collection Waves", "Raw Evidence", "Normalization", "Observations", "Entity Resolution", "Relationships", "Temporal Graph", "Timeline/Map/Media", "Claims/Hypotheses", "Source Independence", "Contradictions", "Verification", "Knowledge Update", "Next Best Action", "Stop", "Report", "Replay"]}</data></node><node id="data:evidence"><data key="