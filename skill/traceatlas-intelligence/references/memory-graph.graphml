ENTINT"><data key="d0">PAYMENTINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "authorized payment instruments/rails, merchant and settlement context", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:CRYPTOINT"><data key="d0">CRYPTOINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "public/authorized blockchain evidence, wallet/transaction context without doxxing", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:BRANDINT"><data key="d0">BRANDINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "brands, trademark links, impersonation and reputation context", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:ADINT"><data key="d0">ADINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "public advertisement transparency, campaign content and source claims", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:MARKETPLACEINT"><data key="d0">MARKETPLACEINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "public marketplace listings, sellers and fraud/brand context", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:JOBINT"><data key="d0">JOBINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "public job postings and workforce/capability signals", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:COMPLAINTINT"><data key="d0">COMPLAINTINT</data><data key="d1">intelligence_module</data><data key="d2">{"description": "public/authorized complaints, duplication and status", "canonical_65": true, "implementation_status": "NOT_VERIFIED"}</data></node><node id="module:EXPOSUREINT"><data key="d0">EXPOSUREINT</data><data key="d1">intelligence_module<